{
  "name": "rtc-proyecto8-api-rest-files",
  "version": "1.0.0",
  "description": "API REST Files dedicada a documentar los conciertos y canciones de The Eras Tour",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed:songs": "node src/seeds/seedSongs.js",
    "seed:concerts": "node src/seeds/seedConcerts.js",
    "seed": "npm run seed:songs && npm run seed:concerts"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "cloudinary",
    "api-rest",
    "the-eras-tour"
  ],
  "author": "Araceli Fradejas Muñoz",
  "license": "ISC",
  "dependencies": {
    "cloudinary": "^2.10.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.9.4",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
